DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
DEBUG=True
# Em produção (Railway): domínio próprio + wildcard de tenant + o domínio
# público que o Railway atribui (ver RAILWAY_PUBLIC_DOMAIN mais abaixo, que
# é adicionado automaticamente). Exemplo real de produção:
# ALLOWED_HOSTS=syncora.app,.syncora.app
ALLOWED_HOSTS=localhost,127.0.0.1,.syncora.app,.localhost

# Em dev local, usa as variáveis DB_* abaixo. Em produção (Railway), o addon
# de Postgres injeta DATABASE_URL automaticamente — quando essa variável
# existe, ela tem prioridade e as DB_* abaixo são ignoradas (ver
# config/settings/base.py). Não precisa preencher as duas.
DATABASE_URL=
DB_NAME=syncora
DB_USER=syncora_dev
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Em dev local aponta pro Redis nativo. Em produção (Railway), o addon de
# Redis injeta REDIS_URL automaticamente do mesmo jeito que o Postgres.
REDIS_URL=redis://localhost:6379/0

# Só existe automaticamente no ambiente do Railway (não precisa definir à
# mão) — usado só para incluir o domínio *.up.railway.app em ALLOWED_HOSTS/
# CSRF_TRUSTED_ORIGINS enquanto o domínio próprio ainda não está propagado.
RAILWAY_PUBLIC_DOMAIN=

# Upload de arquivos (logos, fotos, documentos) — em branco, usa disco local
# (ok pra dev, não recomendado em produção num servidor stateless). Preencha
# pra usar armazenamento S3-compatível (AWS S3, Cloudflare R2, Backblaze B2).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Domínio administrativo do Super Admin (fora do middleware de tenant) e
# domínio base para resolução de subdomínio. Em dev, use "localhost" — o
# TLD .localhost resolve para 127.0.0.1 sem precisar mexer no hosts file.
PLATFORM_ADMIN_HOST=admin.localhost
TENANT_BASE_DOMAIN=localhost

EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@syncora.app

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me

# Sincronização de calendário externo (Google/Outlook) — deixe em branco até
# criar as credenciais reais no Google Cloud Console / Azure AD. Ver
# apps/calendar_sync/providers.py para o que cadastrar em cada console
# (escopos, redirect URI). CALENDAR_SYNC_HOST é um domínio fixo (fora da
# resolução de tenant) porque os provedores exigem um redirect_uri
# cadastrado antecipadamente e idêntico a cada chamada — não dá pra
# cadastrar o subdomínio de cada empresa.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
CALENDAR_SYNC_HOST=connect.localhost
CALENDAR_SYNC_CALLBACK_BASE_URL=http://connect.localhost:8000

# Site de cadastro self-service (apps/onboarding) — em dev, "localhost" já
# cai no TENANT_BYPASS_HOSTS, então este valor só importa em produção. NÃO é
# o site institucional/marketing (esse é estático, no Netlify, fora do
# Django) — por isso fica num subdomínio tipo "app.syncora.app", não no
# domínio apex, que em produção aponta para o Netlify.
MARKETING_HOST=app.syncora.app

# Sentry é opcional — em branco, o app roda normalmente sem monitoramento de
# erros (ver config/settings/production.py). Só usado quando DJANGO_SETTINGS_MODULE=config.settings.production.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ENVIRONMENT=production
